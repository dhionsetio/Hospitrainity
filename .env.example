APP_NAME=Hospitrainity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Prototype privacy contact. Set real reviewed values before production.
PRIVACY_OPERATOR_NAME="Dhion Setio"
PRIVACY_CONTACT_EMAIL="dhionsetio@gmail.com"
PRIVACY_CONTROLLER_ESTABLISHED=false

# Generate one long-lived VAPID pair for the deployment; never commit the private key.
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_SUBJECT="mailto:dhionsetio@gmail.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional curriculum artifact overrides (used by isolated automation).
# CURRICULUM_STANDALONE_OUTPUT=
# CURRICULUM_REPORT_DIRECTORY=
# CURRICULUM_ROLLBACK_DIRECTORY=
# Local/testing preview only. Production rejects draft delivery regardless.
CURRICULUM_ALLOW_DRAFT_ACTIVE_PREVIEW=true

# Disposable local/test database seeding is disabled unless explicitly enabled.
# Supply separate randomly generated values of at least 24 characters; never
# reuse a real password or commit these variables.
HOSPITRAINITY_DEMO_SEED=false
# HOSPITRAINITY_DEMO_SUPERADMIN_PASSWORD=
# HOSPITRAINITY_DEMO_SUPERVISOR_PASSWORD=
# HOSPITRAINITY_DEMO_LEARNER_PASSWORD=
HOSPITRAINITY_INVITATION_TTL_HOURS=72
