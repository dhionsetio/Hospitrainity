{
  "$id": "https://hospitrainity.curriculum/schema/feedback-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/meta"
    }
  ],
  "properties": {
    "code": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/editorial_code"
    },
    "content_version": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/semver"
    },
    "entity_type": {
      "const": "feedback-model"
    },
    "id": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
    },
    "messages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "feedback_type": {
            "enum": [
              "success",
              "error_specific",
              "hint",
              "model_reveal",
              "next_step"
            ]
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "feedback_type",
          "text"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "prompt_code": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/editorial_code"
    },
    "replaced_by": {
      "oneOf": [
        {
          "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaces": {
      "oneOf": [
        {
          "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_locator": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/source_locator"
    },
    "status": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/status"
    }
  },
  "required": [
    "id",
    "code",
    "content_version",
    "status",
    "entity_type",
    "source_locator",
    "prompt_code",
    "messages"
  ],
  "title": "Feedback model",
  "type": "object"
}
