{
  "$id": "https://hospitrainity.curriculum/schema/answer-model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/meta"
    }
  ],
  "properties": {
    "accepted": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "code": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/editorial_code"
    },
    "content_version": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/semver"
    },
    "entity_type": {
      "const": "answer-model"
    },
    "id": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
    },
    "prompt_code": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/editorial_code"
    },
    "replaced_by": {
      "oneOf": [
        {
          "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaces": {
      "oneOf": [
        {
          "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "scoring_mode": {
      "enum": [
        "none",
        "objective_exact",
        "objective_normalized",
        "rubric",
        "self_report"
      ]
    },
    "source_locator": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/source_locator"
    },
    "status": {
      "$ref": "https://hospitrainity.curriculum/schema/_meta.schema.json#/$defs/status"
    }
  },
  "required": [
    "id",
    "code",
    "content_version",
    "status",
    "entity_type",
    "source_locator",
    "prompt_code",
    "scoring_mode"
  ],
  "title": "Answer model",
  "type": "object"
}
