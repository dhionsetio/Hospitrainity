# Copy this file to the production secret store and replace every placeholder.
# Never commit the populated production environment file.
APP_NAME=Hospitrainity
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-host.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=replace-with-your-supported-driver
DB_HOST=replace-me
DB_PORT=replace-me
DB_DATABASE=replace-me
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=replace-with-your-production-mailer
MAIL_SCHEME=null
MAIL_HOST=replace-me
MAIL_PORT=replace-me
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM_ADDRESS=replace-me
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
# Enable these only after confirming that every subdomain is HTTPS-only and preload requirements are understood.
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

VITE_APP_NAME="${APP_NAME}"
