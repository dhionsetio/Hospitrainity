            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Register in one line: formal writing uses full words and titles, such as “Dear Mr. Chen” and “I would be happy to help.” Casual writing uses short forms and slang, such as “Hey” and “no worries.” With guests, lean formal and warm. You can always soften a formal message, but a too-casual one is hard to take back.",
                    "underline": false
                }
            ],
