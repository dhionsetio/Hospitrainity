            "order": 1,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Here is a habit that sharpens your writing fast. Take any short reply you have written and read it out loud once. If a sentence feels stiff or cold, rewrite it the way you would actually say it to a guest at the desk, then check that it is still polite. Reading aloud is the quickest way to hear the difference between correct writing and warm writing.",
                    "underline": false
                }
            ],
            "source_locator": {
