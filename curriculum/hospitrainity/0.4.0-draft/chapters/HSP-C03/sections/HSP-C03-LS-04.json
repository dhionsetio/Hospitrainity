        {
            "caption": "Step 2. Key vocabulary: Word or phrase / What it means / How you might say it",
            "header": [
                "Word or phrase",
                "What it means",
                "How you might say it"
            ],
            "id": "7745a078-ab7f-5465-b092-c44aa435170b",
            "language": "en",
            "order": 2,
            "provenance_kind": "source_verbatim",
            "rows": [
                [
                    "to put on hold",
                    "to pause a call politely",
                    "“May I put you on hold for a moment?”"
                ],
                [
                    "availability",
                    "whether rooms are free",
                    "“Let me check availability for you.”"
                ],
                [
                    "room rate",
                    "the price for one night",
                    "“The room rate is 80 dollars per night.”"
                ],
                [
                    "to spell out",
                    "to say a word letter by letter",
                    "“Could you spell that out for me?”"
                ],
                [
                    "to read back",
                    "to repeat details to confirm them",
                    "“Let me read that back to you.”"
                ],
                [
                    "extension",
                    "an internal phone number",
                    "“You can reach me on extension 12.”"
                ],
                [
                    "to take a message",
                    "to note information for someone else",
                    "“May I take a message?”"
                ],
                [
                    "booking reference",
                    "the code for a reservation",
                    "“Your booking reference is 452.”"
                ],
                [
                    "to transfer a call",
                    "to pass a call to another person",
                    "“I will transfer your call now.”"
                ],
                [
                    "enquiry",
                    "a question or request for information",
                    "“Thank you for your enquiry.”"
                ],
                [
                    "to hang up",
                    "to end a call",
                    "“Please do not hang up.”"
                ],
                [
                    "caller",
                    "the person who is phoning",
                    "“The caller would like a quiet room.”"
                ]
            ],
