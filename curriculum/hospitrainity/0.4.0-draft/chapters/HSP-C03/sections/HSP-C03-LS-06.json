                    "underline": false
                },
                {
                    "bold": true,
                    "italic": false,
                    "text": "C:",
                    "underline": false
                },
                {
                    "bold": false,
                    "italic": false,
                    "text": " Hi, I would like to book a room for next weekend.",
                    "underline": false
                },
                {
                    "bold": false,
                    "italic": false,
                    "text": "\n",
                    "underline": false
                },
                {
                    "bold": true,
                    "italic": false,
                    "text": "A:",
