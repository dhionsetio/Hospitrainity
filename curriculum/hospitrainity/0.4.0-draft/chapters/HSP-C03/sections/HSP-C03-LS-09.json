        {
            "id": "66713922-cbda-52d2-ae4b-f0df20dab3e3",
            "language": "en",
            "order": 20,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "“Good afternoon, the Grand Serenata Hotel, Maya speaking. How may I help you? ... I would be happy to help. Let me check availability for those two nights. ... Yes, we have a room. Could I take your name and a contact number? ... Let me read that back to be sure. ... Your booking reference is four, five, three. Thank you for calling, and we look forward to welcoming you.”",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 327,
                "chapter": 3,
                "heading_path": [
                    "Dealing with Customers on the Phone",
                    "Step 6. Role-play"
                ],
                "normalized_text_sha256": "c6e07fbc84e4c228fd766c2143d51057440aa0d69bcda4a46efa3b5603c6fe0c"
            },
            "text": "“Good afternoon, the Grand Serenata Hotel, Maya speaking. How may I help you? ... I would be happy to help. Let me check availability for those two nights. ... Yes, we have a room. Could I take your name and a contact number? ... Let me read that back to be sure. ... Your booking reference is four, five, three. Thank you for calling, and we look forward to welcoming you.”",
            "type": "paragraph"
        },
