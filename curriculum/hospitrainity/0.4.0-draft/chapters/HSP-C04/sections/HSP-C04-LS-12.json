            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Be efficient, but never let yourself sound like a machine. Scripts and saved replies are genuinely useful, yet the guest should always feel spoken to, not simply processed. A few pointers:",
                    "underline": false
                }
            ],
            "source_locator": {
