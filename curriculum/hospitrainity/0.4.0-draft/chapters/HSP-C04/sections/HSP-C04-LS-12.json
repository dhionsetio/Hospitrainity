{
    "blocks": [
        {
            "id": "1f756cd7-d7ae-52f4-9b53-e695706da97d",
            "language": "en",
            "order": 1,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Here is a quick drill that builds real speed. Have a friend read you a short order and a room number a little faster than feels comfortable, then read it straight back and add an estimated time. Do it three times. This trains the exact reflex a hotline needs, which is to listen, read back, and confirm, all without losing your warmth.",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 507,
                "chapter": 4,
                "heading_path": [
                    "The Guest-Services Hotline",
                    "Take it further"
                ],
