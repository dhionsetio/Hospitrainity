                "normalized_text_sha256": "b409b47b425c6d4ed95cbef5f9395baae3b76a17e35403741bd0dc007cf416d7"
            },
            "text": "Busy does not have to sound busy. A few small habits keep you calm and kind:",
            "type": "paragraph"
        },
        {
            "id": "bf04922b-9515-52f8-8ce5-f7976f3e2183",
            "language": "en",
            "order": 17,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Take a slow breath before you answer. Your voice follows your breath.",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 421,
                "chapter": 4,
                "heading_path": [
                    "The Guest-Services Hotline",
                    "Step 3. Useful phrases, grouped by what they do"
                ],
                "normalized_text_sha256": "46d3a04ce6a1791b304cda6760b9b2c2f95713791c2003eb637c602793b994ab"
            },
            "text": "Take a slow breath before you answer. Your voice follows your breath.",
            "type": "list_item"
        },
        {
            "id": "d8b32354-e6e2-5100-953e-08122626d50d",
            "language": "en",
            "order": 18,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Never let the guest hear that you are rushed. A hurried tone makes them feel like a bother.",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 422,
                "chapter": 4,
                "heading_path": [
