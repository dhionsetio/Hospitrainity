                "normalized_text_sha256": "62f67e6c77916cce51c8ba6d6eb72a746cea5845798e5ce934612473d7ca5c83"
            },
            "text": "Never let the guest hear that you are rushed. A hurried tone makes them feel like a bother.",
            "type": "list_item"
        },
        {
            "id": "60648c31-5ca0-5875-9457-084ced849731",
            "language": "en",
            "order": 19,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Use warm little signals, such as “of course” and “right away,” so they feel looked after.",
                    "underline": false
                }
            ],
            "source_locator": {
