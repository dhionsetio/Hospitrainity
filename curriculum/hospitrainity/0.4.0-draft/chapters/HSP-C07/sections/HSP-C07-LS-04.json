            "text": "Read each example out loud once. Saying it is the quickest way to remember it.",
            "type": "instruction"
        },
        {
            "caption": "Step 2. Key vocabulary: Word or phrase / What it means / How you might say it",
            "header": [
                "Word or phrase",
                "What it means",
                "How you might say it"
            ],
            "id": "a31720c1-67ff-5d55-911e-d9285011b908",
            "language": "en",
            "order": 2,
            "provenance_kind": "source_verbatim",
            "rows": [
                [
                    "complaint",
                    "an expression of dissatisfaction",
                    "“I would like to make a complaint.”"
                ],
                [
                    "to apologise",
                    "to say sorry sincerely",
                    "“I sincerely apologise for this.”"
                ],
                [
                    "inconvenience",
                    "trouble or difficulty caused",
                    "“I am sorry for the inconvenience.”"
                ],
                [
                    "to take ownership",
                    "to accept responsibility yourself",
                    "“Let me take care of this for you.”"
                ],
                [
                    "to resolve",
                    "to fix a problem",
                    "“We will resolve this right away.”"
                ],
                [
                    "refund",
                    "money returned to the guest",
                    "“We will arrange a full refund.”"
                ],
                [
                    "goodwill gesture",
                    "a kind extra to make up for a problem",
                    "“As a goodwill gesture, breakfast is on us.”"
                ],
                [
                    "to reassure",
                    "to help someone feel confident again",
                    "“Let me reassure you that this is now fixed.”"
                ],
                [
                    "service recovery",
                    "turning an unhappy guest back into a happy one",
                    "“Good service recovery builds loyalty.”"
                ],
                [
                    "to follow up",
                    "to check back a little later",
                    "“I will follow up with you this evening.”"
                ],
                [
                    "to escalate",
                    "to bring in a manager for help",
                    "“I will escalate this to my manager.”"
                ],
                [
                    "empathy",
                    "showing you understand how they feel",
                    "“That sounds really frustrating.”"
                ]
            ],
