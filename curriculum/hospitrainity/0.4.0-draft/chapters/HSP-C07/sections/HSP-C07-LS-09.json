        {
            "id": "fc4d8fdc-5457-5a05-92df-2acd57fe7a28",
            "language": "en",
            "order": 20,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "“I am very sorry to hear that, and I understand how frustrating it is to lose the Wi-Fi all day. This is the Listen and ",
                    "underline": false
                },
                {
                    "bold": false,
                    "italic": false,
                    "text": "Apologise",
                    "underline": false
                },
                {
                    "bold": false,
                    "italic": false,
                    "text": " part. Let me send our technician to your room right away, and I will switch you to our backup network in the meantime. This is the Act part. As an apology, I would like to offer you a late check-out, and I will check back within the hour to make sure it is working. This is the Follow up part.”",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 916,
                "chapter": 7,
                "heading_path": [
                    "Dealing with Problems and Complaints",
                    "Step 6. Role-play"
                ],
                "normalized_text_sha256": "c9e0d82d410a4ca305021672bb23e289ed53eb9a707e3f6b0e91ea0d5586e7bc"
            },
            "text": "“I am very sorry to hear that, and I understand how frustrating it is to lose the Wi-Fi all day. This is the Listen and Apologise part. Let me send our technician to your room right away, and I will switch you to our backup network in the meantime. This is the Act part. As an apology, I would like to offer you a late check-out, and I will check back within the hour to make sure it is working. This is the Follow up part.”",
            "type": "paragraph"
        },
