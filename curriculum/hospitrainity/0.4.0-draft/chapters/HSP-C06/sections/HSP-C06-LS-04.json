            "rows": [
                [
                    "live chat",
                    "real-time messaging on a website",
                    "“Ask us anytime on live chat.”"
                ],
                [
                    "direct message (DM)",
                    "a private message on social media",
                    "“Please send us a DM.”"
                ],
                [
                    "response time",
                    "how quickly you reply",
                    "“Our response time is under five minutes.”"
                ],
                [
                    "quick reply",
                    "a saved, ready-made answer",
                    "“I have a quick reply for that question.”"
                ],
                [
                    "to escalate",
                    "to pass an issue to a higher level",
                    "“I will escalate this to the front desk.”"
                ],
                [
                    "chatbot",
                    "an automated chat assistant",
                    "“The chatbot answers common questions.”"
                ],
                [
                    "OTA",
                    "an online travel agency, such as a booking site",
                    "“The guest booked through an OTA.”"
                ],
                [
                    "review",
                    "public feedback about the hotel",
                    "“Thank you for your kind review.”"
                ],
                [
                    "to take it to DM",
                    "to continue in a private channel",
                    "“Let us take this to a DM.”"
                ],
                [
                    "to go offline / private",
                    "to move away from a public thread",
                    "“Could we continue this privately?”"
                ],
                [
                    "professional tone",
                    "friendly but appropriate style",
                    "“Keep a professional tone online.”"
                ],
                [
                    "emoji",
                    "a small picture that adds warmth",
                    "“One friendly emoji is plenty.”"
                ]
            ],
