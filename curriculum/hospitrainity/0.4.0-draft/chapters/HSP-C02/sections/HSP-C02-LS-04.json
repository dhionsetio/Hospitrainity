        {
            "caption": "Step 2. Key vocabulary: Word or phrase / What it means / How you might say it",
            "header": [
                "Word or phrase",
                "What it means",
                "How you might say it"
            ],
            "id": "a95b5560-bb1c-52d2-9f84-ed66b916ff37",
            "language": "en",
            "order": 2,
            "provenance_kind": "source_verbatim",
            "rows": [
                [
                    "reservation / booking",
                    "a room arranged in advance",
                    "“I have a reservation under Chen.”"
                ],
                [
                    "front desk / reception",
                    "the counter where guests check in",
                    "“Please come to the front desk.”"
                ],
                [
                    "to check in",
                    "to register when you arrive",
                    "“I would like to check in, please.”"
                ],
                [
                    "to check out",
                    "to settle up and leave",
                    "“What time is check-out?”"
                ],
                [
                    "walk-in guest",
                    "a guest who arrives with no booking",
                    "“We have one room left for walk-in guests.”"
                ],
                [
                    "ID / passport",
                    "an identity document",
                    "“Could I see your passport, please?”"
                ],
                [
                    "key card",
                    "the card that opens the room",
                    "“Here is your key card.”"
                ],
                [
                    "amenities",
                    "the extra services and facilities",
                    "“Our amenities include free Wi-Fi and a gym.”"
                ],
                [
                    "breakfast voucher",
                    "a ticket that pays for breakfast",
                    "“Here is your breakfast voucher.”"
                ],
                [
                    "luggage",
                    "a guest’s bags",
                    "“May I help you with your luggage?”"
                ],
                [
                    "deposit",
                    "money held in case of extra charges",
                    "“We take a small deposit at check-in.”"
                ],
                [
                    "to confirm",
                    "to check that something is correct",
                    "“Let me confirm your booking.”"
                ]
            ],
