        {
            "id": "e5c42f21-0457-5e65-afbf-d449ed9b6150",
            "language": "en",
            "order": 1,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "A useful challenge: record yourself doing a full check-in out loud, from the first greeting to the final goodbye, in under ninety seconds. Play it back once and ask yourself two questions: did I sound warm, and did I use the guest’s name? Try it a second time and keep the better take. Speaking out loud is where real confidence is built.",
                    "underline": false
                }
            ],
            "source_locator": {
                "artifact": "Hospitrainity.docx",
                "body_index": 213,
                "chapter": 2,
                "heading_path": [
