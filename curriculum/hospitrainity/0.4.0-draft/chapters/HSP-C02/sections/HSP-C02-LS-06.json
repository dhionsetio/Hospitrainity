            "order": 3,
            "provenance_kind": "source_verbatim",
            "runs": [
                {
                    "bold": false,
                    "italic": false,
                    "text": "Notice what the receptionist did well: welcomed first, used the guest’s name, explained the deposit before taking it, and shared breakfast and Wi-Fi without being asked. That last part is the difference between good service and great service.",
                    "underline": false
                }
            ],
            "source_locator": {
